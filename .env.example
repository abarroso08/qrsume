# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

DB_SERVER=127.0.0.1:3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Adobe PDF Services (PDFtoCV import). Free tier credentials from
# https://developer.adobe.com/document-services/ (OAuth Server-to-Server).
ADOBE_PDF_SERVICES_CLIENT_ID=
ADOBE_PDF_SERVICES_CLIENT_SECRET=
# us (default) or eu: where Adobe processes the documents
ADOBE_PDF_SERVICES_REGION=us
